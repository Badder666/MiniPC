    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Controller Status
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /custom_controller/status_markers
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planned + Live Trajectories
      Namespaces:
        collected_trajectory: true
        planned_trajectory: true
