Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: world
      Plane: XY
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 120; 120; 120
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Controller Live Pose
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /custom_controller/target/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 1.0
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: target
    - Class: rviz_default_plugins/MarkerArray
      Name: Controller Status
      Enabled: false
      Topic:
        Value: /custom_controller/status_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Planned + Live Trajectories
      Enabled: true
      Topic:
        Value: /custom_controller/trajectory_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
  Global Options:
    Fixed Frame: world
    Background Color: 35; 38; 43
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Focal Point:
        X: 0.0
        Y: 0.1
        Z: 0.15
      Pitch: 0.2
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Height: 900
  Width: 1400
